#!/bin/sh
# Record backlight, DPMS/enabled and compositor frame commits across login so
# a black screen can be traced (backlight on / panel prepared vs. no commits).
# Loop by iteration count: the RTC jumps when NTP syncs.
LOG=/run/tb-display-watch.log
: > "$LOG"
i=0
last=
while [ "$i" -lt 1800 ]; do
	b=$(cat /sys/class/backlight/sy7758-backlight/brightness 2>/dev/null)
	a=$(cat /sys/class/backlight/sy7758-backlight/actual_brightness 2>/dev/null)
	p=$(cat /sys/class/backlight/sy7758-backlight/bl_power 2>/dev/null)
	d=
	e=
	for f in /sys/class/drm/card*-DSI-1/dpms; do
		if [ -e "$f" ]; then d=$(cat "$f" 2>/dev/null); fi
	done
	for f in /sys/class/drm/card*-DSI-1/enabled; do
		if [ -e "$f" ]; then e=$(cat "$f" 2>/dev/null); fi
	done
	raw=$(awk -F'total_framecount:' '/total_framecount/ {print $2+0}' /sys/kernel/debug/dri/*/crtc-0/status 2>/dev/null)
	if [ -n "$raw" ]; then
		last=$raw
		fresh=1
	else
		fresh=0
	fi
	s=$(loginctl list-sessions --no-legend 2>/dev/null | awk '{printf "%s:%s:%s ", $1, $3, $7}')
	echo "$(date '+%H:%M:%S') b=$b a=$a pwr=$p dpms=$d en=$e pc=$last new=$fresh $s" >> "$LOG"
	i=$((i + 1))
	sleep 1
done
