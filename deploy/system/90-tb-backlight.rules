# TB710FU: allow the video group to write the backlight (user-level brightness tools).
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="sy7758-backlight", RUN+="/usr/bin/chgrp video /sys/class/backlight/sy7758-backlight/brightness", RUN+="/usr/bin/chmod g+w /sys/class/backlight/sy7758-backlight/brightness"
