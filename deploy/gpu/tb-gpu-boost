#!/usr/bin/env python3
"""TB710FU：安卓式 GPU 输入加速（触摸即抬频，松手渐进回落）。

内核的 GPU 调速器只有 simple_ondemand（默认 50 ms 才采样一次），
没有安卓的 msm-adreno-tz。安卓的做法是"手指一碰屏幕，先把 GPU 最低
频率顶到高位，松手后再逐级降下来"，这样滚动、窗口动画的头几帧不会
掉在 231 MHz 上。这里通过 devfreq 的 min_freq 实现同样的效果，
simple_ondemand 仍然负责高负载时继续往上冲。

  触摸中/刚松手：629 MHz
  松手 1.2 s 后：422 MHz
  松手 4 s 后：231 MHz（回最低，不影响待机功耗）

频率状态按单调时钟推进，不依赖输入事件：即使设备被拔掉、read 出错，
循环也不会空转，且一定会在时限内回落。触摸设备热插拔时重新扫描，
失效的 fd 立即关闭——旧版正是卡在已删除的测试设备上 100% 占 CPU，
并让 GPU 最低频率永远停在 629 MHz。
"""
import glob
import os
import select
import struct
import time

GPU_NAME = '3d00000.gpu'
BOOST_FREQ = 629000000
HOLD_FREQ = 422000000
IDLE_FREQ = 231000000
POLL_MS = 20
BOOST_HOLD = 1.2
DECAY_AFTER = 4.0
RESCAN_SECONDS = 2.0

EV_KEY = 0x01
EV_ABS = 0x03
BTN_TOUCH = 0x14a
ABS_MT_TRACKING_ID = 0x39
EVENT = struct.Struct('llHHi')
EVENT_SIZE = EVENT.size


def log(msg):
    print(msg, flush=True)


def gpu_dir(timeout=30.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for d in glob.glob('/sys/class/devfreq/*'):
            try:
                with open(os.path.join(d, 'name')) as f:
                    if f.read().strip() == GPU_NAME:
                        return d
            except OSError:
                continue
        time.sleep(1)
    raise RuntimeError('找不到 %s 的 devfreq 节点' % GPU_NAME)


def write_attr(path, value):
    try:
        with open(path, 'w') as f:
            f.write(str(value))
        return True
    except OSError as exc:
        log('写 %s=%s 失败: %s' % (path, value, exc))
        return False


def find_touch_devices():
    """按名字找触摸屏和手写笔，返回事件设备路径。"""
    found = []
    for ev in sorted(glob.glob('/dev/input/event*')):
        name_path = '/sys/class/input/%s/device/name' % os.path.basename(ev)
        try:
            with open(name_path) as f:
                name = f.read().strip()
        except OSError:
            continue
        low = name.lower()
        # uinput 测试设备是临时节点，测试进程退出后 fd 会变成死句柄，
        # 没有理由为它们抬频。
        if 'denial-test' in low:
            continue
        if 'touch' in low or 'pen' in low or 'stylus' in low:
            found.append((ev, name))
    return found


class Booster:
    def __init__(self, gdir):
        self.min_path = os.path.join(gdir, 'min_freq')
        self.poll_path = os.path.join(gdir, 'polling_interval')
        self.level = IDLE_FREQ
        self.last_active = 0.0
        self.active = False

    def set_level(self, freq, why):
        if freq == self.level:
            return
        if write_attr(self.min_path, freq):
            self.level = freq
            log('GPU 最低频率 -> %d MHz（%s）' % (freq // 1000000, why))

    def touch(self, now):
        """有触摸活动：立即抬到最高档，之后的回落只看时钟。"""
        self.last_active = now
        self.active = True
        self.set_level(BOOST_FREQ, '触摸中')

    def apply_decay(self, now):
        """按时间推进频率档位；返回距离下一档还有多少秒。"""
        if not self.active:
            return None
        since = now - self.last_active
        if since > DECAY_AFTER:
            self.set_level(IDLE_FREQ, '空闲回落')
            self.active = False
            return None
        if since > BOOST_HOLD:
            self.set_level(HOLD_FREQ, '松手保持')
            return DECAY_AFTER - since
        return BOOST_HOLD - since


class TouchWatcher:
    """持有触摸设备 fd，热插拔时增删，绝不保留失效句柄。"""

    def __init__(self):
        self.fds = {}
        self.next_scan = 0.0

    def scan(self):
        now = time.monotonic()
        if now < self.next_scan:
            return
        self.next_scan = now + RESCAN_SECONDS
        open_paths = {path for path, _ in self.fds.values()}
        for path, name in find_touch_devices():
            if path in open_paths:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
            except OSError as exc:
                log('打开 %s 失败: %s' % (path, exc))
                continue
            self.fds[fd] = (path, name)
            log('监听触摸：%s（%s）' % (name, path))

    def drop(self, fd):
        path, name = self.fds.pop(fd, (None, None))
        try:
            os.close(fd)
        except OSError:
            pass
        if name:
            log('触摸设备已移除：%s（%s）' % (name, path))

    def paths(self):
        return list(self.fds)


def scan_events(data):
    """返回 (是否有输入, 手指状态)；手指状态 None 表示这包事件没说。"""
    activity = False
    down = None
    for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
        _, _, etype, code, value = EVENT.unpack_from(data, off)
        if etype not in (EV_KEY, EV_ABS):
            continue
        activity = True
        if etype == EV_KEY and code == BTN_TOUCH:
            down = value != 0
        elif etype == EV_ABS and code == ABS_MT_TRACKING_ID:
            down = value != -1
    return activity, down


def main():
    gdir = gpu_dir()
    boost = Booster(gdir)
    write_attr(boost.poll_path, POLL_MS)
    # 启动就把下限收回最低档：上个实例异常退出时可能留在 629 MHz。
    write_attr(boost.min_path, IDLE_FREQ)
    log('GPU 加速守护启动：%s，simple_ondemand 采样 %d ms'
        % (gdir, POLL_MS))

    watcher = TouchWatcher()
    watcher.scan()
    if not watcher.fds:
        log('暂时没有触摸设备，继续等待热插拔')

    while True:
        now = time.monotonic()
        watcher.scan()
        wait = boost.apply_decay(now)
        if wait is None:
            timeout = RESCAN_SECONDS
        else:
            timeout = max(0.0, min(wait, RESCAN_SECONDS))

        fds = watcher.paths()
        readable = []
        if fds:
            try:
                readable, _, _ = select.select(fds, [], [], timeout)
            except (OSError, ValueError):
                readable = []

        for fd in readable:
            try:
                data = os.read(fd, EVENT_SIZE * 32)
            except OSError:
                # ENODEV：设备已经不存在，留着它 select 会一直可读。
                watcher.drop(fd)
                continue
            if not data:
                watcher.drop(fd)
                continue
            activity, _ = scan_events(data)
            if activity:
                boost.touch(time.monotonic())


if __name__ == '__main__':
    main()
