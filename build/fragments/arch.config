# Arch Linux additions on top of the repo's kernel/config-7.2.6-tb710fu.
# One CONFIG per line (=y / =m / =n). Applied with scripts/kconfig/merge_config.sh;
# anything Kconfig refuses is reported by build_kernel.sh.
#
# Deliberately NOT inherited from the SteamOS fragment:
#   HID_STEAM / STEAM_FF          - no Steam controller
#   NTSYNC                        - Wine/Proton ntsync, no Proton here
#   ANDROID_BINDER_IPC/BINDERFS   - Valve's Lepton container only
#   LEDS_TRIGGER_PATTERN          - konkr-controls breathing LED
#   UCLAMP_TASK/UCLAMP_TASK_GROUP - konkrd thread boosting
#   OVERLAY_FS=y                  - SteamOS mounts /etc and /var as overlays; Arch does not,
#                                   so a module is enough (=m below)

# /etc overlay is not used, but keep the fs available for experiments
CONFIG_OVERLAY_FS=m

# --- systemd (Arch's init) - the options systemd's "required" list wants built in
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_MISC=y
CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- storage / removable media: USB sticks, SD cards, external SSDs on the USB-C port
CONFIG_USB_UAS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XATTR=y
CONFIG_UNICODE=y
CONFIG_NLS_UTF8=y

# --- containers / packaging the Arch user may reach for
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y

# --- debugging this port from ssh (no serial cable)
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_DEBUG_KERNEL=y
CONFIG_SCHED_DEBUG=y
CONFIG_DEBUG_INFO_NONE=y

# --- image size: the packed boot_a has to fit ABL's ~86.5 MB raw limit (stock ZUXOS kernel
#     34 MB + 4 MiB kShimC + this Image + DTB, each 2 MiB aligned). Measured with the debug
#     symbols below: 91.8 MB, over the limit. KALLSYMS_ALL only adds *data* symbols to
#     /proc/kallsyms - function names, which oops decoding needs, stay; SLUB_DEBUG and
#     RCU_TRACE are trace frameworks this port does not use.
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_RCU_TRACE is not set

# --- suspend: this board only has s2idle; the debug knobs above make a failed sleep explain itself
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
