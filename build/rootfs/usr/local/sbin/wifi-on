#!/bin/sh
# TB710FU: load ath12k once its PCIe endpoint exists, then let NetworkManager
# take over. The module is blacklisted (modprobe.d/tb710fu-wifi.conf) because it
# has hung this board when probed too early.
#
# PCIe enumerates late on this board (~4.7 s on a cold boot). The old fixed
# `sleep 10` in tb-wifi.service was approximating this wait; probing before the
# endpoint exists loads the module without binding it, and phy0 never appears.
set -e
i=0
while [ $i -lt 60 ] && [ ! -e /sys/bus/pci/devices/0000:01:00.0 ]; do
	sleep 0.25; i=$((i+1))
done
if [ -e /sys/bus/pci/devices/0000:01:00.0 ]; then
	sleep 1			# let the link settle before the firmware download
else
	echo "PCIe endpoint missing after 15 s - falling back to the old 10 s delay"
	sleep 10
fi
rfkill unblock wifi 2>/dev/null || true
modprobe ath12k_wifi7 || modprobe ath12k
echo "ath12k requested"
