#!/bin/sh
# TB710FU: wait for phy0 and let NetworkManager bring the link up.
#
# Deliberately NOT on the boot critical path (After=multi-user.target): a slow
# firmware download on this board (cold boot has taken ~110 s) must not hold up
# the login screen. tb-wifi.service has already requested the module by now.
set -e
echo "waiting for phy0 (cold boot can take ~110 s)..."
i=0; while [ $i -lt 90 ] && [ ! -d /sys/class/ieee80211/phy0 ]; do sleep 2; i=$((i+1)); done
[ -d /sys/class/ieee80211/phy0 ] && echo "phy0 after $((i*2)) s" || { echo "phy0 did not appear"; exit 1; }
iw reg set CN 2>/dev/null || true
nmcli radio wifi on 2>/dev/null || true
