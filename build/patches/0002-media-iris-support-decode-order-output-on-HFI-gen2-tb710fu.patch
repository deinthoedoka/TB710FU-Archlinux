From: TB710FU port of the qcom-va-driver kernel patch series
Subject: [PATCH] media: iris: support decode-order output on HFI gen2 (tb710fu base)

Port of radxa qcom-va-driver patches/0001 to the 7.2.6-tb710fu base
(the upstream patch does not apply: this base lacks the REQUEST_SYNC_FRAME
context). Exposes V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY(_ENABLE) as the
DISPLAY_DELAY caps and wires HFI_PROP_DECODE_ORDER_OUTPUT (0x0300015b) to
the firmware. Mandatory for VA-API: clients decode synchronously and stall
forever if the firmware only returns frames in display order.
Regenerate with: deploy/vaapi/port_decode_order.py

--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -154,6 +154,10 @@
 		return LAYER4_BITRATE_HEVC;
 	case V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L5_BR:
 		return LAYER5_BITRATE_HEVC;
+	case V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE:
+		return DISPLAY_DELAY_ENABLE;
+	case V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY:
+		return DISPLAY_DELAY;
 	default:
 		return INST_FW_CAP_MAX;
 	}
@@ -297,6 +301,10 @@
 		return V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L4_BR;
 	case LAYER5_BITRATE_HEVC:
 		return V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_L5_BR;
+	case DISPLAY_DELAY_ENABLE:
+		return V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE;
+	case DISPLAY_DELAY:
+		return V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY;
 	default:
 		return 0;
 	}
